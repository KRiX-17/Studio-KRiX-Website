# Public Cloudflare Turnstile widget key. This value is intentionally browser-visible.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Supabase portfolio backend. The publishable key is safe for browser use when RLS is correct.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only secrets and mail routing. Never use real values in this file.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
RESEND_API_KEY=your_resend_api_key
CONTACT_TO_EMAIL=private-inbox@example.invalid
SUPPORT_TO_EMAIL=support-inbox@example.invalid
CONTACT_FROM_EMAIL=Studio KRiX <forms@send.example.invalid>
